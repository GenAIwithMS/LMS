# Database Configuration
DATABASE_URI=mysql+pymysql://username:password@localhost/llm_LMS

# JWT Configuration
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# How many minutes a login lasts before the user must log in again
JWT_EXPIRES_MINUTES=30

# Websites allowed to call the API (comma separated). Your frontend address.
CORS_ORIGINS=http://localhost:3000

# Flask Configuration
# Only set to True on your own computer, never on a server
FLASK_DEBUG=False
PORT=5000

# Groq API (Optional - for chatbot)
GROQ_API_KEY=your-groq-api-key-here

# Chat model (Groq). Leave CHAT_REASONING_FORMAT empty for non-reasoning models.
CHAT_MODEL=qwen/qwen3-32b
CHAT_REASONING_FORMAT=hidden
